# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Firebase Service Account
# On Render: Paste minified JSON string as FIREBASE_SERVICE_ACCOUNT_JSON
# On Local: You can set FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_CREDENTIALS_PATH=service_account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=

# Authentication & Access Control
# Authorized Google account email
ALLOWED_EMAIL=user@example.com
# Set DEV_MODE=true for local development/testing without strict Google OAuth enforcement
DEV_MODE=true

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000,https://your-app.vercel.app

# External Financial Data APIs (Optional / Enhanced Features)
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_ALLOWED_DOMAINS=hankyung.com,mk.co.kr,edaily.co.kr,sedaily.com,chosun.com,donga.com,joins.com
DATA_GO_KR_KEY=
