# 이 파일을 복사해 backend/.env 로 만든 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 실행 환경: development(내 컴퓨터) / production(배포). Render에서는 자동으로 production 취급
APP_ENV=development

# 로그인 없이 API를 열지 여부. 내 컴퓨터에서 테스트할 때만 true로 바꾸세요. (운영에서는 자동으로 꺼짐)
DEV_MODE=false

# OpenAI (없으면 채팅은 '오프라인 안내'만, 캡처 인식은 사용 불가)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase 서비스 계정 (둘 중 하나). 없으면 로컬에서는 .local_db JSON 파일에 저장, 운영에서는 실행 중단
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=

# 접근을 허용할 구글 계정 (쉼표로 여러 개 가능). 운영에서는 비워 두면 아무도 못 들어옵니다.
ALLOWED_EMAIL=

# CORS 허용 주소 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000

# 공시·뉴스 (없으면 등락 이유 찾기에서 '확인하지 못했어요'로 안내)
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_ALLOWED_DOMAINS=yna.co.kr,hankyung.com,mk.co.kr,edaily.co.kr,sedaily.com,mt.co.kr,chosun.com,donga.com,joongang.co.kr,hani.co.kr,khan.co.kr,biz.chosun.com,fnnews.com,newsis.com

# FinanceDataReader가 막힐 때 쓰는 금융위원회 시세 API (공공데이터포털 '일반 인증키(Decoding)')
DATA_GO_KR_KEY=

# 종목-코스피 등락률 차이가 이 값(%p) 이상이면 공시·뉴스를 찾아봄 (조사 시작 기준일 뿐 원인 판단 아님)
INVESTIGATION_THRESHOLD_PCT=2.0
